{
  "name": "whyte-creatives",
  "version": "1.0.0",
  "private": true,
  "description": "whyteCreatives \u2014 photography & videography portfolio site (Akosombo, Ghana)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/build-studio.mjs && next build",
    "build:site": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "studio": "sanity dev --port 3333 --host 0.0.0.0",
    "studio:build": "node scripts/build-studio.mjs",
    "studio:deploy": "sanity deploy",
    "seed": "node scripts/seed-sanity.mjs"
  },
  "dependencies": {
    "@sanity/vision": "^6.20.0",
    "next": "^16.4.2",
    "next-sanity": "^13.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
