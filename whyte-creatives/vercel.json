{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/studio/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/galleries",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/works",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/wedding",
      "permanent": false
    },
    {
      "source": "/services/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/ratecards",
      "destination": "/wedding",
      "permanent": false
    },
    {
      "source": "/weddings",
      "destination": "/wedding",
      "permanent": true
    },
    {
      "source": "/gallery-3",
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/gallery/:slug",
      "destination": "/portfolio",
      "permanent": false
    }
  ]
}
